# ==============================================================================
# SAITM Placement Portal — Environment Variables (example)
# ==============================================================================
# Placeholders ONLY. Never commit real values — every `.env*` variant except
# these `.env.example` files is git-ignored.
#
# Three files, three purposes — do not merge them:
#
#   frontend/.env.local          NEXT_PUBLIC_* ONLY (sections 1-4).
#                                Everything here ships to the browser.
#                                Mirror these in Vercel → Settings → Env Vars.
#
#   backend/functions/.env       Functions RUNTIME only (section 5) — exactly
#                                the keys functions/src reads. Loaded by the
#                                Firebase CLI on deploy/emulate.
#
#   backend/functions/.env.seed  Local seed/provisioning only (sections 6-8).
#                                Sourced by hand, never deployed.
#
# Rules:
#   - NEXT_PUBLIC_* values ARE shipped to the browser — keep true secrets OUT.
#   - Storage split is locked: Cloudinary = media, Firebase Storage = documents.
#   - GCLOUD_PROJECT / GOOGLE_CLOUD_PROJECT are RESERVED by the Functions
#     runtime. Putting them in backend/functions/.env makes `firebase deploy`
#     FAIL. They belong in .env.seed (the runtime provides them automatically).
# ==============================================================================


# ==============================================================================
# FRONTEND — frontend/.env.local  (and Vercel environment variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Development Mock Authentication Mode — OPTIONAL
#    "true"  → mock auth + sample data; Firebase is not contacted at all.
#              Sign in with the seeded accounts (see docs/21_DEVELOPMENT_MODE.md).
#    "false" → always use the real Firebase stack, even under `next dev`.
#    unset   → on when NODE_ENV=development, off in production builds.
#
#    MUST be "false" (or unset) in every deployed environment that serves real
#    users: with it on, the app accepts seeded credentials and shows fabricated
#    placement data.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEV_MODE=false

# ------------------------------------------------------------------------------
# 1. Firebase Web SDK — REQUIRED
#    Firebase Console → Project settings → Your apps → Web app → SDK config.
#    Public by design; safe to expose. Auth/Firestore/Storage are dead without
#    them — the app boots on demo placeholders and logs a console error.
#
#    While NEXT_PUBLIC_DEV_MODE=true these may stay blank — nothing reads them.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy-your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# Verify in the console (Storage → top of page). Projects created from
# ~late-2024 use <project>.firebasestorage.app; older ones .appspot.com.
# A wrong value breaks every document upload.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional — Google Analytics. Omit to disable.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Callable Functions region — MUST equal FUNCTIONS_REGION in the backend.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# "true" routes all SDK calls to the local Emulator Suite. MUST be "false" in
# any deployed environment, or the browser calls 127.0.0.1 and everything fails.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Messaging — OPTIONAL (web push)
#    Console → Project settings → Cloud Messaging → Web configuration →
#    Web Push certificates. Nothing reads this yet; stored for when FCM token
#    registration is wired up.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key

# ------------------------------------------------------------------------------
# 3. Cloudinary — REQUIRED for image uploads (media ONLY)
#    Logos, student photos, banners, gallery, campus images.
#    Cloud name: Cloudinary → Dashboard (top left).
#    Preset:     Settings → Upload → Upload presets → add one with
#                Signing Mode = UNSIGNED. No default exists; create it.
#    The API key/secret must NEVER appear here — unsigned uploads only.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ------------------------------------------------------------------------------
# 4. Institutional constraint — REQUIRED (client + functions)
#    Domains permitted to sign in as a student, comma-separated. Set BOTH so
#    the frontend and Cloud Functions agree — the client check is UX only, the
#    callables re-validate. First entry is the institutional domain and is what
#    the UI names in placeholders and errors.
#
#    SECURITY: every extra domain removes an identity guarantee. With gmail.com
#    listed, anyone holding a Gmail inbox can create a student account — the
#    domain gate is the only thing proving a student belongs to the college.
#    Drop it back to `saitm.ac.in` alone to restore that guarantee.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=saitm.ac.in
ALLOWED_EMAIL_DOMAIN=saitm.ac.in


# ==============================================================================
# BACKEND — backend/functions/.env  (Cloud Functions runtime)
# ==============================================================================

# ------------------------------------------------------------------------------
# 5. Functions runtime
# ------------------------------------------------------------------------------
# Region for every callable — must match NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION.
FUNCTIONS_REGION=asia-south1

# Server-side pepper mixed into OTP hashing. REQUIRED in production — the
# fallback is a public constant from the source, which makes hashed OTPs
# guessable. Generate 48 random bytes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Prefer Secret Manager: firebase functions:secrets:set OTP_PEPPER
# Changing this invalidates every OTP currently in flight.
OTP_PEPPER=replace-with-a-long-random-secret

# --- CORS: browser origins allowed to call the callables -----------------------
# Comma-separated, scheme + host + port, NO trailing slash. Add every deployed
# frontend origin (custom domain and/or the Vercel production URL). The
# project's own *.web.app / *.firebaseapp.com domains are allowed automatically.
# REQUIRED before go-live: leaving it empty blocks production browsers.
CORS_ALLOWED_ORIGINS=https://placements.saitm.ac.in,https://your-project.vercel.app

# Optional — allow that ONE Vercel project's per-commit preview URLs
# (https://<slug>-<hash>.vercel.app). Never a blanket *.vercel.app.
# CORS_VERCEL_PREVIEW_PROJECT=your-vercel-project-slug

# Optional — http://localhost:3000 and http://127.0.0.1:3000 are allowed by
# default so `next dev` can reach deployed functions. Set "false" to lock
# production down to deployed origins only.
# CORS_ALLOW_LOCALHOST=false

# --- SMTP: how OTP / verification emails actually get delivered ----------------
# REQUIRED for a code to reach an inbox. Without SMTP_USER + SMTP_PASS, mail is
# only written to the Firestore `mail` collection (which needs the "Trigger
# Email from Firestore" extension, and does NOT run in the emulator).
#
# Gmail: enable 2-Step Verification, then create an App Password
# (myaccount.google.com → Security → App passwords) — 16 chars, spaces removed.
# The normal account password is rejected. Gmail caps ~500 recipients/day, and
# recruiter verification shares this quota with student OTPs.
# Prefer Secret Manager: firebase functions:secrets:set SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=replace-with-16-char-app-password
# Optional — Gmail forces From to match SMTP_USER, so usually leave unset.
# MAIL_FROM=SAITM Placement Portal <you@gmail.com>

# FUNCTIONS_EMULATOR is set automatically ("true") by the emulator runtime.
# Never set it by hand. Shown for reference only.
# FUNCTIONS_EMULATOR=true


# ==============================================================================
# SEED / PROVISIONING — backend/functions/.env.seed  (local only, never deployed)
# ==============================================================================

# ------------------------------------------------------------------------------
# 6. Target project + Admin SDK credentials
#    Used by seed-admin.mjs / seed-demo.mjs.
# ------------------------------------------------------------------------------
GCLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id

# Absolute path to a service-account JSON key — Firebase Console → Project
# settings → Service accounts → Generate new private key. Store it OUTSIDE the
# repo. REQUIRED to seed against a real (non-emulator) project.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json

# ------------------------------------------------------------------------------
# 7. Admin provisioning (seed-admin.mjs)
#    There is no public admin signup — admins are provisioned out-of-band.
#    Sign in once at /portal, change this password, then blank it here.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@saitm.ac.in
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Placement Cell Admin

# Optional — uid of a student to receive a welcome notification on seed.
# STUDENT_UID=some-firebase-auth-uid

# ------------------------------------------------------------------------------
# 8. Cloudinary server-side — NOT USED YET
#    Nothing in backend/functions/src reads these; the portal uses unsigned
#    client uploads. Kept for future signed uploads / admin deletes. If wired
#    up, move the secret into Secret Manager:
#      firebase functions:secrets:set CLOUDINARY_API_SECRET
# ------------------------------------------------------------------------------
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 9. Local Emulator Suite — dev only
#    Point the seed scripts at the emulators instead of a real project.
#    Ports match backend/firebase.json. Leave UNSET when targeting production.
# ------------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
