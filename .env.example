# ==============================================================================
# SAITM Placement Portal — Environment Variables (example)
# ==============================================================================
# Copy the relevant sections into the correct location and fill real values.
# Three files, three purposes — do not merge them:
#
#   frontend/.env.local          NEXT_PUBLIC_* ONLY (sections 1-4).
#                                Everything here ships to the browser.
#
#   backend/functions/.env       Functions RUNTIME only (section 5) — exactly the
#                                keys functions/src reads: FUNCTIONS_REGION,
#                                ALLOWED_EMAIL_DOMAIN, OTP_PEPPER,
#                                CORS_ALLOWED_ORIGINS. Loaded by the
#                                Firebase CLI on deploy/emulate.
#
#   backend/functions/.env.seed  Local seed/provisioning only (sections 6-9):
#                                GCLOUD_PROJECT, GOOGLE_CLOUD_PROJECT,
#                                GOOGLE_APPLICATION_CREDENTIALS, ADMIN_*,
#                                CLOUDINARY_API_*. Sourced by hand, never deployed.
#
# Rules:
#   - NEVER commit real secrets. This file holds placeholders only.
#   - NEXT_PUBLIC_* values ARE shipped to the browser — keep true secrets OUT of them.
#   - Storage split is locked: Cloudinary = media, Firebase Storage = documents.
#   - GCLOUD_PROJECT / GOOGLE_CLOUD_PROJECT are RESERVED by the Functions runtime.
#     Putting them in backend/functions/.env makes `firebase deploy` FAIL. They
#     belong in .env.seed (the runtime provides them automatically).
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Firebase — Web / Client SDK  (Frontend/.env.local)
#    Firebase Console → Project settings → Your apps → Web app → SDK config.
#    NEXT_PUBLIC_* is exposed to the browser (safe for Firebase web config keys).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy-your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloud Functions region — MUST match the backend deploy region (FUNCTIONS_REGION).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# "true" routes all SDK calls to the local Firebase Emulator Suite (dev only).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false


# ------------------------------------------------------------------------------
# 2. Firebase Cloud Messaging (FCM) — Web Push  (Frontend/.env.local)
#    Web push key pair: Firebase Console → Project settings → Cloud Messaging
#    → Web configuration → Web Push certificates (VAPID key pair).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key


# ------------------------------------------------------------------------------
# 3. Cloudinary — media (client, unsigned upload)  (Frontend/.env.local)
#    Media ONLY: logos, student photos, banners, gallery, campus images.
#    Create an UNSIGNED upload preset in Cloudinary → Settings → Upload.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset


# ------------------------------------------------------------------------------
# 4. Institutional constraint  (client + functions)
#    Domains permitted to sign in as a student, comma-separated. Set BOTH so the
#    frontend and Cloud Functions agree — the client check is UX only, the
#    callables re-validate. First entry is the institutional domain and is what
#    the UI names in placeholders and errors.
#
#    SECURITY: every extra domain removes an identity guarantee. With gmail.com
#    listed, anyone holding a Gmail inbox can create a student account — the
#    domain gate is the only thing proving a student belongs to the college.
#    Drop it back to `saitm.ac.in` alone to restore that guarantee.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=saitm.ac.in,gmail.com
ALLOWED_EMAIL_DOMAIN=saitm.ac.in,gmail.com


# ------------------------------------------------------------------------------
# 5. Firebase Cloud Functions — runtime config  (backend/functions)
#    Set via Firebase Functions env (functions .env / secrets), not the client.
# ------------------------------------------------------------------------------
# Region the callable functions are deployed to (keep in sync with the frontend).
FUNCTIONS_REGION=asia-south1

# Server-side pepper mixed into OTP hashing. MUST be a long random secret in prod.
# Store as a Firebase secret: `firebase functions:secrets:set OTP_PEPPER`.
OTP_PEPPER=replace-with-a-long-random-secret

# --- CORS: browser origins allowed to call the callables -----------------------
# Comma-separated, scheme + host + port, NO trailing slash. Add every deployed
# frontend origin (custom domain and/or the Vercel production URL). The project's
# own *.web.app / *.firebaseapp.com domains are allowed automatically.
# Leaving this empty blocks production browsers — only localhost would work.
CORS_ALLOWED_ORIGINS=https://placements.saitm.ac.in,https://saitm-placement-portal.vercel.app

# Optional — allow that ONE Vercel project's per-commit preview URLs
# (https://<slug>-<hash>.vercel.app). Never a blanket *.vercel.app.
# CORS_VERCEL_PREVIEW_PROJECT=saitm-placement-portal

# Optional — http://localhost:3000 and http://127.0.0.1:3000 are allowed by
# default so `next dev` can hit deployed functions. Set "false" to lock
# production down to deployed origins only.
# CORS_ALLOW_LOCALHOST=false

# --- SMTP: how OTP / verification emails actually get delivered ---------------
# Without SMTP_USER + SMTP_PASS, mail is only written to the Firestore `mail`
# collection (needs the "Trigger Email from Firestore" extension, which does NOT
# run in the emulator) — so no code reaches any inbox.
#
# Gmail: enable 2-Step Verification, then create an App Password
# (myaccount.google.com → Security → App passwords) — 16 chars. The normal
# account password is rejected. Gmail caps ~500 recipients/day.
# Store the password as a secret in prod: `firebase functions:secrets:set SMTP_PASS`
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=replace-with-16-char-app-password
# MAIL_FROM=SAITM Placement Portal <you@gmail.com>

# FUNCTIONS_EMULATOR is set automatically ("true") by the emulator runtime.
# Do NOT set this by hand in production. Shown here for reference only.
# FUNCTIONS_EMULATOR=true


# ------------------------------------------------------------------------------
# 6. Cloudinary — server-side (OPTIONAL)
#    Only needed if/when you perform SIGNED uploads or admin deletes from the
#    backend. The current app uses unsigned client uploads (section 3) and does
#    NOT require these. Keep the secret server-side only — never NEXT_PUBLIC_*.
# ------------------------------------------------------------------------------
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret


# ------------------------------------------------------------------------------
# 7. Firebase Admin SDK / Service Account  (backend scripts & CI deploy)
#    Used by seed-admin.mjs / seed-demo.mjs (applicationDefault) and by any
#    server that talks to Firebase with admin privileges.
# ------------------------------------------------------------------------------
# Absolute path to a service-account JSON key (used against a REAL project).
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# Target project id (either name works; usually auto-provided in GCP runtimes).
GCLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id


# ------------------------------------------------------------------------------
# 8. Local Emulator Suite  (backend/functions — dev only)
#    Set these to point seed scripts at the emulators instead of a real project.
#    Ports match backend/firebase.json. Leave UNSET when targeting production.
# ------------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099


# ------------------------------------------------------------------------------
# 9. Seed / provisioning scripts  (backend/functions — run in your shell)
#    Admins are provisioned out-of-band (no public admin signup):
#      node seed-admin.mjs      # needs ADMIN_EMAIL + ADMIN_PASSWORD
#      node seed-demo.mjs       # optional STUDENT_UID for a welcome notification
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@saitm.ac.in
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Placement Cell Admin

# Optional: uid of a student to receive a personal welcome notification on seed.
# STUDENT_UID=some-firebase-auth-uid


# ------------------------------------------------------------------------------
# 10. Email delivery  (OPTIONAL — backend/functions)
#     By default the portal queues mail to the Firestore `mail` collection,
#     delivered by the Firebase "Trigger Email from Firestore" extension
#     (no env vars required). Configure the extension's SMTP connection there.
#     If you swap lib/email.ts for a direct provider (SendGrid / Resend / SMTP),
#     add the matching credentials below and keep them server-side only.
# ------------------------------------------------------------------------------
# SENDGRID_API_KEY=SG.your-sendgrid-api-key
# RESEND_API_KEY=re_your-resend-api-key
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM="SAITM Placement Portal <no-reply@saitm.ac.in>"
