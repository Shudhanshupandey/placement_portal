{
  "name": "saitm-portal-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions for the SAITM Placement Portal (auth OTP, custom tokens).",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.24",
    "typescript": "^5.7.2"
  }
}
