# Dependencies
node_modules/
.pnp
.pnp.js

# Builds / Next.js
# Lowercase to match the real folder names — a case-sensitive checkout (CI,
# Linux) would not match the old Frontend/ + Backend/ spellings.
frontend/.next/
frontend/out/
frontend/build/
.dist/
backend/functions/lib/

# Environment (only .env.example is committed)
# Ignore EVERY .env variant at any depth, then re-allow the examples.
.env
.env.*
!.env.example
!**/.env.example

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Logs (runtime/debug only — keep the folder, ignore contents)
logs/*
!logs/.gitkeep

# Testing
coverage/
playwright-report/
test-results/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
