# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND environment — copy to `.env.local` for local dev, and mirror every
# key into Vercel → Project → Settings → Environment Variables for deploys.
#
# ONLY NEXT_PUBLIC_* belongs here: everything in this file is compiled into the
# browser bundle. True secrets (OTP pepper, SMTP password, admin password,
# Cloudinary API secret) live in backend/functions/.env and .env.seed.
#
# Full annotated reference, including the backend keys: ../.env.example
# ─────────────────────────────────────────────────────────────────────────────

# ── Development Mock Authentication Mode — OPTIONAL ──────────────────────────
# "true"  → mock auth + sample data; Firebase is never contacted. Sign in with
#           the seeded accounts listed in docs/21_DEVELOPMENT_MODE.md.
# "false" → always use the real Firebase stack, even under `next dev`. Set this
#           the moment real credentials land below.
# unset   → on when NODE_ENV=development, off in production builds.
# MUST be "false" or unset in any deployment that serves real users.
NEXT_PUBLIC_DEV_MODE=false

# ── Firebase Web SDK — REQUIRED ──────────────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app → SDK config.
# May stay blank while NEXT_PUBLIC_DEV_MODE=true — nothing reads them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Confirm the exact bucket in the console (Storage → top of page): newer
# projects use <project>.firebasestorage.app, older ones <project>.appspot.com.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Google Analytics. Leave blank to disable.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Must match FUNCTIONS_REGION in backend/functions/.env.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# "true" → local Emulator Suite. MUST be "false" in every deployed environment,
# otherwise the browser calls 127.0.0.1 and every request fails.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ── Firebase Cloud Messaging — OPTIONAL ──────────────────────────────────────
# Console → Project settings → Cloud Messaging → Web Push certificates.
# Not read by any code yet; reserved for web-push registration.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Institutional constraint — REQUIRED ──────────────────────────────────────
# Comma-separated. Must mirror ALLOWED_EMAIL_DOMAIN in backend/functions/.env.
# First entry is the institutional domain used in user-facing copy.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=saitm.ac.in

# ── Cloudinary — REQUIRED for image uploads (media only) ─────────────────────
# Cloud name: Cloudinary → Dashboard. Preset: Settings → Upload → Upload
# presets → create one with Signing Mode = UNSIGNED (none exists by default).
# Never put the API key/secret here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
